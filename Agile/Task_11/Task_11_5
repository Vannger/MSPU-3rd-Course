SELECT
  quest_type,
  COUNT(*) AS total_cnt,
  COUNT(*) FILTER (WHERE status = 'failed') AS fail_cnt,
  SUM(reward_gold - consumables_cost - fine)
    FILTER (WHERE status = 'completed') AS completed_gold
FROM quests
GROUP BY quest_type
HAVING
  (COUNT(*) FILTER (WHERE status = 'failed'))::numeric / COUNT(*) > 0.20
  OR
  SUM(reward_gold - consumables_cost - fine)
    FILTER (WHERE status = 'completed') > 800;
