SELECT
  id,
  source_file,
  line_no,
  CAST(
    REPLACE(
      REPLACE(
        regexp_replace(raw_line, '.*?("|\s)([0-9 ,]+[.,][0-9]{2}).*', '\2'),
        ' ',
        ''
      ),
      ',',
      '.'
    ) AS NUMERIC
  ) AS normalized_amount
FROM claims_import_lines
WHERE raw_line ~ '[0-9][0-9 ,]*[.,][0-9]{2}';
